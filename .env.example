# 复制本文件为 .env（双击「打开知源.cmd」或运行 start.py 会自动完成）。
# 仓库里不含任何密钥：下面两把 *_B64 都是占位符，请填自己在
#   https://ai.tju.edu.cn 个人中心获取的密钥。端点已经是本项目专属地址，
#   所以每人用自己的 Key，调用量一样记在本项目上。
#   也可以在「设置 → 模型」里填写，只写进本机 .env，不会进仓库。
TJU_API_KEY_B64=
TJU_BASE_URL=https://ai.tju.edu.cn/api/agent2026/gitlab-83-agent2026-笔记管理智能体/
TJU_MODEL=tju-llm
DATA_DIR=data
# Optional local HTTP/SOCKS proxy, for example: http://127.0.0.1:7897
TJU_PROXY_URL=
TJU_TIMEOUT_SECONDS=90
KNOWORIGIN_ADMIN_PASSWORD=
# auto: request JSON mode, retry without it if provider rejects response_format.
# force: require JSON mode. off: never send response_format.
TJU_JSON_MODE=auto
# ---- MinerU 可选 PDF 精排后端（需先 `pip install mineru` 并下载模型）----
# 默认已关闭：PDF 上传走本地快速解析（不阻塞）。
# 如需 MinerU 的整齐 Markdown/公式/图表排版，设为 true 开启；解析失败仍回退本地。
MINERU_ENABLED=false
# 有文字层的 PDF 即使开启 MinerU 也跳过（本地提取秒级完成），设为 false 强制全部走 MinerU
MINERU_SKIP_TEXT_PDF=true
# 解析后端：pipeline（纯 CPU，兼容性最好）、hybrid-engine（默认，需 GPU）、vlm-engine 等
MINERU_BACKEND=pipeline
# 解析方法 auto|txt|ocr（仅 pipeline / hybrid* 后端生效）
MINERU_METHOD=auto
# 文档语言（如 ch）：可提升 OCR 准确率
MINERU_LANG=ch
# mineru 命令名或绝对路径
MINERU_CLI=mineru
# 解析超时（秒）；单篇论文首次解析需下载/加载模型，建议 >= 600
MINERU_TIMEOUT_SECONDS=600
# ---- 扫描件 PDF（无文字层）识别路线 ----
# fast：本地 OCR 优先（RapidOCR，随 pip 依赖自动安装、自带模型、中文优化；
#       未装 RapidOCR 时退化到 Tesseract），失败回退视觉模型
# quality：MinerU / 视觉模型优先（质量更好、速度慢），本地 OCR 仅作最后兜底
SCANNED_PDF_BACKEND=fast
# 以下为可选兜底引擎 Tesseract 的配置（一般不装也能用，RapidOCR 已够用）：
# tesseract.exe 的绝对路径（可选；留空则自动探测 PATH / tools\tesseract / 默认安装目录）
TESSERACT_CMD=
# Tesseract OCR 语言包（默认 chi_sim 简体中文）
TESSERACT_LANG=chi_sim

# ---- 视觉模型（扫描件 / 拍照讲义识别，走智谱 glm-4v-flash）----
TJU_VISION_API_KEY_B64=

# ---- AI 用量记账（可选）----
# 是否记录每次模型调用的估算用量。关掉即完全回退（不建表、不记账）。
KNOWORIGIN_USAGE_TRACKING=true
# 每人每日估算 token 上限；0 或留空 = 不限额。
# 超限时该用户的 AI 功能返回 429 并给出中文提示，次日零点自动重置。
# 多人共用一份 TJU_API_KEY 时建议设置，否则一个人刷爆额度其他人只会看到「AI 不好用了」。
KNOWORIGIN_USAGE_DAILY_QUOTA=0

# ---- AI 长期记忆（可选）----
# 让 AI 从对话里记住你的背景、目标与讲解偏好，并在陪学对话中自动带上。
# 记忆可在「学习产出区 → AI 记忆」里查看与删除。
KNOWORIGIN_MEMORY_ENABLED=true

# ---- 通知中心 / 周报（可选）----
# 每周生成一次学习周报（无模型可用时自动退化为统计版）。
KNOWORIGIN_NOTICE_WEEKLY=true
